# ============================================================
#   Cab Fare Comparator — Environment Variables
#   Copy this file to .env and fill in YOUR credentials
# ============================================================

# --- UBER ---
UBER_PHONE=+919876543210
UBER_PASSWORD=your_uber_password_here

# --- OLA ---
OLA_PHONE=+919876543210
OLA_PASSWORD=your_ola_password_here

# --- RAPIDO ---
RAPIDO_PHONE=+919876543210
RAPIDO_PASSWORD=your_rapido_password_here

# --- SETTINGS ---
# Dashboard auto-refresh interval in minutes (default: 5)
REFRESH_INTERVAL_MINUTES=5

# Run browser in headless mode? (True = no browser window, False = visible)
HEADLESS=False

# Scraper retries for timeouts / parse failures (login failures are not retried)
SCRAPE_RETRIES=3
SCRAPE_RETRY_BACKOFF_SEC=2

# Skip logging a successful quote if the same fare was stored this recently
DEDUP_WINDOW_MINUTES=2

# Background scheduler (python scheduler.py)
SCHEDULE_INTERVAL_MINUTES=15
DEFAULT_PICKUP=Hawa Mahal, Jaipur, Rajasthan
DEFAULT_DESTINATION=Jaipur International Airport, Sanganer

# Optional override (defaults to data/fares.db)
# DB_PATH=data/fares.db

LOG_LEVEL=INFO
